{
  "name": "inkling",
  "productName": "Inkling",
  "version": "0.2.0",
  "description": "Visual thinking on the desktop, from the keyboard.",
  "author": "hi-jin",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/kalam": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.hi-jin.inkling",
    "productName": "Inkling",
    "files": ["main.js", "preload.js", "app/**/*"],
    "directories": { "output": "dist" },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": ["dmg"],
      "identity": null
    }
  }
}
